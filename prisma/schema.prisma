generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id @default(uuid())
  name             String     @unique
  email            String     @unique
  password         String
  previousPassword String
  createdAt        DateTime   @default(now()) @db.Date
  role             UserRole   @default(USER)
  status           UserStatus @default(INATIVO)
  closedLogs       CartLog[]  @relation("CartLogClosedBy")
  openedLogs       CartLog[]  @relation("CartLogOpenedBy")
  tickets          Ticket[]
}

model Ticket {
  id          String       @id @default(uuid())
  id_csc      String       @unique
  category    String
  description String
  openAt      DateTime     @db.Date
  authorId    String
  status      TicketStatus @default(EM_ANDAMENTO)
  closedAt    DateTime?    @db.Date
  author      User         @relation(fields: [authorId], references: [id])
}

model Cart {
  id              String     @id @default(uuid())
  patrimony       String     @unique
  school          String
  room            String
  name            String
  totalNotebooks  Int
  actualNotebooks Int
  status          CartStatus @default(FECHADO)
  createdAt       DateTime   @default(now()) @db.Date
  updatedAt       DateTime   @default(now()) @db.Date
  logs            CartLog[]
}

model CartLog {
  id             String    @id @default(uuid())
  cartId         String
  openedById     String
  openedAt       DateTime  @default(now())
  openedQuantity Int
  teacherName    String
  closedById     String?
  closedAt       DateTime?
  closedQuantity Int?
  notesAtClose   String?
  notesAtOpen    String?
  cart           Cart      @relation(fields: [cartId], references: [id])
  closedBy       User?     @relation("CartLogClosedBy", fields: [closedById], references: [id])
  openedBy       User      @relation("CartLogOpenedBy", fields: [openedById], references: [id])
}

enum TicketStatus {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  CANCELADO
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum UserRole {
  ADMIN
  USER
}

enum CartStatus {
  FECHADO
  ABERTO
}


enum CategoryDocs {
  INFRAESTRUTURA
  ROTINA
  EVENTOS
  SISTEMAS
}

model Document {
  id               String     @id @default(uuid())
  title String
  slug  String @unique
  category CategoryDocs
  description String
  lastUpdated DateTime @default(now())
}